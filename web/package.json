{
  "name": "stripe-entitlements-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npm --prefix ../typescript ci",
    "billing:build": "npm --prefix ../typescript run build && npm rebuild --offline @tosea/stripe-entitlements",
    "predev": "npm run billing:build",
    "dev": "next dev",
    "prebuild": "npm run billing:build",
    "build": "next build",
    "postbuild": "node scripts/verify-runtime-traces.mjs",
    "start": "next start",
    "prelint": "npm run billing:build",
    "lint": "eslint .",
    "pretypecheck": "npm run billing:build",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run billing:build",
    "test": "vitest run",
    "test:e2e:simulation": "playwright test --config=playwright.simulation.config.ts",
    "test:e2e:stripe": "playwright test --config=playwright.stripe.config.ts",
    "test:promo": "playwright test --config=playwright.promo.config.ts"
  },
  "dependencies": {
    "@tosea/stripe-entitlements": "file:../typescript",
    "@stripe/stripe-js": "9.14.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "nanoid": "3.3.18",
    "js-yaml": "4.3.1"
  }
}
